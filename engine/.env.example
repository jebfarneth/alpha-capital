# Alpha Capital Engine - Environment Variables
# Copy to .env and fill in values. Never commit real keys.

# Database
DATABASE_URL=sqlite:///alpha_capital.db

# FMP (Financial Modeling Prep) - Ultimate tier
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# Alpaca - paper trading by default
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon/Massive - supplemental I3 short interest / short-volume data
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.massive.com

# SEC EDGAR - public API identity, no API key
SEC_USER_AGENT=Alpha Capital Your Name your_email@example.com

# FDA / clinical trial public sources
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# FINRA - public market/regulatory datasets via OAuth client credentials
FINRA_BASE_URL=https://api.finra.org
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# Nasdaq Trader halt feed - public page/feed source
NASDAQ_TRADER_HALT_URL=https://www.nasdaqtrader.com/trader.aspx?id=TradeHalts

# Benzinga API - catalyst/news enrichment
BENZINGA_API_KEY=
BENZINGA_BASE_URL=https://api.benzinga.com
